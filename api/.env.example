# --- Server ---
PORT=8000
FRONTEND_URL=

# --- Database (PostgreSQL) ---
DATABASE_URL=

# --- Stock / chat ---
PENDING_ACTION_TTL_MINUTES=15

# --- JWT ---
ACCESS_TOKEN_SECRET=
# หน่วยเป็นวินาที — access token เพิกถอนกลางคันไม่ได้ (เป็น JWT ไม่ใช่แถวใน DB)
# ยิ่งอายุยาว ยิ่งเป็นช่วงที่ token ที่หลุดออกไปแล้วยังใช้ได้ 900 = 15 นาที
# ตามมาตรฐานทั่วไป ฝั่งเว็บต่ออายุเองอัตโนมัติผ่าน POST /auth/refresh อยู่แล้ว
ACCESS_TOKEN_EXPIRES_IN=900
# 2592000 = 30 วัน
REFRESH_TOKEN_EXPIRES_IN=2592000
RESET_TOKEN_EXPIRES_IN=
# อายุลิงก์ยืนยันอีเมล (วินาที) เช่น 86400 = 24 ชม.
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Two-Factor Authentication (TOTP) ---
# ชื่อที่แสดงในแอป Authenticator เช่น "Aum Manage Stocks"
TWO_FACTOR_APP_NAME=
# คีย์สำหรับเข้ารหัส two_factor_secret ก่อนเก็บลง DB (32 bytes hex)
TWO_FACTOR_ENCRYPTION_KEY=
# คีย์เซ็น challenge token ระหว่างรอกรอกรหัส 6 หลัก — บังคับ อย่างน้อย 32 ตัว
# ไม่ใส่ = api boot ไม่ขึ้นเลย (env.validation บังคับไว้)
TWO_FACTOR_CHALLENGE_SECRET=

# --- LINE (Login + Messaging API) ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# --- AI ---
# Claude API (production)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Ollama (local/dev)
OLLAMA_HOST=
OLLAMA_API_KEY=
OLLAMA_MODEL=

# --- File/Image storage ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Payment ---
# ทั้งสองตัว optional — ไม่ใส่ก็ boot ขึ้นปกติ แต่ endpoint ของ PaymentsModule
# จะตอบ 503 พร้อมบอกว่าขาดตัวไหน
STRIPE_SECRET_KEY=
# ยังจำเป็นอยู่ แม้จะเปลี่ยนมาใช้ PaymentIntent + ยืนยันทันทีที่หน้าเว็บแล้ว
# POST /payments/webhook ยังเปิดอยู่และเป็นตาข่ายรับกรณีที่ผู้ใช้ปิดหน้าเว็บ
# ไปก่อนกดยืนยัน (constructEvent ตรวจลายเซ็นด้วยคีย์นี้)
#
# ดึงค่าได้เลยโดยไม่ต้องเปิด listener:  stripe listen --print-secret
# เวลารับ event จริงตอน dev (api อยู่พอร์ต 8000):
#   stripe listen --forward-to localhost:8000/payments/webhook
#
# ⚠️ staging/production ใช้คนละค่า — เอา signing secret ของ endpoint ที่สร้าง
#    ใน Dashboard มาใส่ ห้ามใช้ค่าจาก CLI เพราะ Stripe เซ็นด้วยคีย์คนละตัว
STRIPE_WEBHOOK_SECRET=

# --- Mail ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
