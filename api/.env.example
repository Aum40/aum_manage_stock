# --- Server ---
PORT=8000
FRONTEND_URL=

# --- Database (PostgreSQL) ---
DATABASE_URL=

# --- Stock / chat ---
PENDING_ACTION_TTL_MINUTES=15

# --- JWT ---
ACCESS_TOKEN_SECRET=
# หน่วยเป็นวินาที — access token เพิกถอนกลางคันไม่ได้ (เป็น JWT ไม่ใช่แถวใน DB)
# ยิ่งอายุยาว ยิ่งเป็นช่วงที่ token ที่หลุดออกไปแล้วยังใช้ได้ 900 = 15 นาที
# ตามมาตรฐานทั่วไป ฝั่งเว็บต่ออายุเองอัตโนมัติผ่าน POST /auth/refresh อยู่แล้ว
ACCESS_TOKEN_EXPIRES_IN=900
# 2592000 = 30 วัน
REFRESH_TOKEN_EXPIRES_IN=2592000
RESET_TOKEN_EXPIRES_IN=
# อายุลิงก์ยืนยันอีเมล (วินาที) เช่น 86400 = 24 ชม.
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Two-Factor Authentication (TOTP) ---
# ชื่อที่แสดงในแอป Authenticator เช่น "Aum Manage Stocks"
TWO_FACTOR_APP_NAME=
# คีย์สำหรับเข้ารหัส two_factor_secret ก่อนเก็บลง DB (32 bytes hex)
TWO_FACTOR_ENCRYPTION_KEY=

# --- LINE (Login + Messaging API) ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# --- AI ---
# Claude API (production)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Ollama (local/dev)
OLLAMA_HOST=
OLLAMA_API_KEY=
OLLAMA_MODEL=

# --- File/Image storage ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Payment ---
# ทั้งสองตัวจำเป็นเฉพาะคนที่ทำ/ทดสอบ PaymentsModule ถ้าไม่เกี่ยวเว้นว่างได้ boot ขึ้นปกติ
STRIPE_SECRET_KEY=
# ดึงค่าได้เลยด้วย (ไม่ต้องเปิด listener ไม่ต้องก๊อปจากหน้าจอ):
#   stripe listen --print-secret
# CLI รุ่นปัจจุบันผูก secret ไว้กับบัญชี ค่าคงที่ข้ามการรันแต่ละครั้ง
# ไม่ได้สุ่มใหม่ทุกครั้งเหมือนรุ่นเก่า แต่ของแต่ละคนเป็นคนละค่า ห้าม commit
#
# เวลารับ event จริงระหว่าง dev (api รันที่พอร์ต 8000 ไม่ใช่ 3000):
#   stripe listen --forward-to localhost:8000/payments/webhook
#
# ⚠️ staging/production ใช้คนละค่า — สร้าง endpoint ใน Stripe Dashboard
#    (Developers > Webhooks) แล้วเอา signing secret ของ endpoint นั้นมาใส่
#    ห้ามเอาค่าจาก CLI ไปใช้ เพราะ Stripe เซ็นด้วย secret คนละตัว
STRIPE_WEBHOOK_SECRET=
# ชื่อที่แสดงบนหน้า Stripe Checkout
STRIPE_CHECKOUT_DISPLAY_NAME=AumStocks

# --- Mail ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
