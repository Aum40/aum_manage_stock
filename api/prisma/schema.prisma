// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/database/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum StockMovementType {
  MANUAL_ADJUSTMENT
  CHAT_ADJUSTMENT
}

enum StockMovementSource {
  WEB
  LINE
}

enum PendingActionSource {
  WEB
  LINE
}

enum PendingActionIntent {
  ADJUST_STOCK
}

enum StockOperation {
  INCREASE
  DECREASE
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model StockMovement {
  id             String              @id @default(uuid()) @db.Uuid
  shopId         String              @db.Uuid
  shopProductId  String              @db.Uuid
  actorId        String?             @db.Uuid
  movementType   StockMovementType
  quantityDelta  Int
  quantityBefore Int
  quantityAfter  Int
  source         StockMovementSource
  note           String?
  referenceType  String?
  referenceId    String?
  createdAt      DateTime            @default(now())
  // TODO(shop-products/staff): add relations after the owning models stabilize.

  @@unique([referenceType, referenceId])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([shopId, shopProductId, createdAt(sort: Desc)])
  @@index([shopId, actorId, createdAt(sort: Desc)])
  @@index([shopId, movementType, createdAt(sort: Desc)])
}

model PendingAction {
  id              String              @id @default(uuid()) @db.Uuid
  shopId          String              @db.Uuid
  actorId         String?             @db.Uuid
  source          PendingActionSource
  originalMessage String
  intent          PendingActionIntent
  shopProductId   String?             @db.Uuid
  productQuery    String
  operation       StockOperation
  quantity        Int
  status          PendingActionStatus @default(PENDING)
  payload         Json?
  expiresAt       DateTime
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  // TODO(shop-products/staff): add relations after the owning models stabilize.

  @@index([shopId, status, createdAt(sort: Desc)])
  @@index([expiresAt, status])
}

enum UserRole {
  SHOP_OWNER
  SHOP_STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  email              String?    @unique
  username           String?    @unique @db.VarChar(50)
  passwordHash       String?    @map("password_hash")
  lineUserId         String?    @unique @map("line_user_id")
  googleId           String?    @unique @map("google_id")
  ownerId            String?    @map("owner_id") @db.Uuid
  role               UserRole
  twoFactorEnabled   Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecretEnc String?    @map("two_factor_secret_enc")
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(2)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(2)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(2)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(2)

  owner                  User?                   @relation("OwnerStaff", fields: [ownerId], references: [id], onDelete: Restrict)
  staff                  User[]                  @relation("OwnerStaff")
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  // feature/subscriptions-resource + feature/shops-resource (พี่ปาน)
  subscription           Subscription?
  shops                  Shop[]

  @@index([email], name: "idx_user_email")
  @@index([username], name: "idx_user_username")
  @@index([lineUserId], name: "idx_user_line")
  @@index([googleId], name: "idx_user_google")
  @@index([ownerId], name: "idx_user_owner")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  usedAt    DateTime? @map("used_at") @db.Timestamptz(2)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(2)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_token_user")
  @@index([familyId], name: "idx_refresh_token_family")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(2)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_password_reset_user")
  @@map("password_reset_tokens")
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_2fa_recovery_user")
  @@map("two_factor_recovery_codes")
}

model categories {
  id           String   @id @default(uuid(7)) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  name         String   @db.VarChar(100)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[] // [เซิ่น] back-relation ที่ Prisma บังคับ — บรรทัดเดียว ไม่แตะ field อื่น

  @@unique([ownerId, name], map: "uq_category_owner_name")
  @@map("categories")
}

// =====================================================

// feature/subscriptions-resource + feature/shops-resource (พี่ปาน)
// ============================================================

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
}

model SubscriptionPlan {
  id                 String  @id @default(uuid()) @db.Uuid
  code               String  @unique @db.VarChar(50) // FREE / PLUS / PRO
  nameTh             String  @map("name_th") @db.VarChar(100)
  priceThb           Decimal @map("price_thb") @db.Decimal(12, 2)
  durationMonths     Int?    @map("duration_months") // NULL = Free Plan ไม่มีวันหมดอายุ
  includedShopQuota  Int     @default(1) @map("included_shop_quota")
  includedStaffQuota Int     @default(0) @map("included_staff_quota") // Free = 0, Plus = 6, Pro = 10
  maxActiveProducts  Int?    @map("max_active_products") // NULL = ไม่จำกัด (Paid), 100 = Free Plan
  isFree             Boolean @default(false) @map("is_free")
  isActive           Boolean @default(true) @map("is_active")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @unique @map("user_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @map("started_at")
  expiresAt        DateTime?          @map("expires_at") // NULL สำหรับ Free Plan
  expiryNotifiedAt DateTime?          @map("expiry_notified_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([expiresAt], name: "idx_subscription_expires")
  @@map("subscriptions")
}

model Shop {
  id          String     @id @default(uuid()) @db.Uuid
  ownerId     String     @map("owner_id") @db.Uuid
  name        String     @db.VarChar(150)
  description String?
  imageUrl    String?    @map("image_url") @db.VarChar(500)
  phone       String?    @db.VarChar(20)
  address     String?
  status      ShopStatus @default(ACTIVE)
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, deletedAt], name: "idx_shop_owner")
  @@map("shops")
}

// ต้องเพิ่มเองใน migration ภายหลัง (Prisma schema เขียนไม่ได้โดยตรง):
// - Seed subscription_plans 3 แถวตาม SRS ฉบับล่าสุด (จำนวนร้าน/สินค้า/
//   พนักงาน เป็นจำนวนตายตัวตามแพ็กเกจ ไม่มีการซื้อสิทธิ์เพิ่มแยกต่างหาก
//   ต้องอัปเกรดแพ็กเกจเท่านั้นถึงจะได้ quota เพิ่ม):
//   - FREE: isFree=true, priceThb=0, includedShopQuota=1, includedStaffQuota=0,
//     maxActiveProducts=100, durationMonths=NULL
//   - PLUS: isFree=false, priceThb=2499, includedShopQuota=3, includedStaffQuota=6,
//     maxActiveProducts=3000, durationMonths=12
//   - PRO: isFree=false, priceThb=3499, includedShopQuota=5, includedStaffQuota=10,
//     maxActiveProducts=5000, durationMonths=12
// - Logic คำนวณ quota / read-only ดู subscription-quota.util.ts
//   (allowed = includedShopQuota ตรงๆ ตามแพ็กเกจ, used = COUNT(shops
//   WHERE ownerId = userId AND deletedAt IS NULL), สร้างร้านได้เมื่อ
//   status = ACTIVE AND used < allowed)
// =====================================================================
// [เซิ่น] feature/products-resource + feature/shop-products-resource
// =====================================================================

/// Product Catalog กลาง ระดับเจ้าของร้าน (owner) — ใช้ร่วมกันได้ทุกร้าน
/// SRS: สินค้าเดียวกันใช้หลายร้าน นับ product quota เพียง 1 รายการ
model Product {
  id         String    @id @default(uuid(7)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  categoryId String?   @map("category_id") @db.Uuid
  name       String    @db.VarChar(200)
  barcode    String?   @db.VarChar(50)
  unit       String    @db.VarChar(20)
  imageUrl   String?   @map("image_url") @db.VarChar(500)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category     categories?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shopProducts ShopProduct[]

  @@index([ownerId, deletedAt], name: "idx_product_owner_deleted")
  @@index([ownerId, name], name: "idx_product_owner_name")
  @@index([categoryId], name: "idx_product_category")
  @@map("products")
}

enum ShopProductStatus {
  ACTIVE
  INACTIVE

  @@map("shop_product_status")
}

/// สินค้าที่แต่ละร้านเลือกมาขาย — ราคาขาย/ต้นทุน/สต็อก แยกตามร้าน
/// SRS: "ข้อมูลระดับร้านต้องประกอบด้วยราคาขาย ต้นทุน จำนวน stock low-stock threshold และสถานะ"
model ShopProduct {
  id                String            @id @default(uuid(7)) @db.Uuid
  shopId            String            @map("shop_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  sellPrice         Decimal           @map("sell_price") @db.Decimal(12, 2)
  costPrice         Decimal           @map("cost_price") @db.Decimal(12, 2)
  stockQty          Int               @default(0) @map("stock_qty")
  lowStockThreshold Int               @default(0) @map("low_stock_threshold")
  status            ShopProductStatus @default(ACTIVE)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // TODO(shops): เพิ่ม relation ไป model Shop เมื่อ feature/shops-resource เข้า dev
  //   shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId], map: "uq_shop_product")
  @@index([shopId, status], name: "idx_shop_product_shop_status")
  @@index([productId], name: "idx_shop_product_product")
  @@map("shop_products")
}
