// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/database/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SHOP_OWNER
  SHOP_STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  email              String?    @unique
  username           String?    @unique @db.VarChar(50)
  passwordHash       String?    @map("password_hash")
  lineUserId         String?    @unique @map("line_user_id")
  googleId           String?    @unique @map("google_id")
  ownerId            String?    @map("owner_id") @db.Uuid
  role               UserRole
  twoFactorEnabled   Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecretEnc String?    @map("two_factor_secret_enc")
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(2)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(2)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(2)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(2)

  owner                  User?                   @relation("OwnerStaff", fields: [ownerId], references: [id], onDelete: Restrict)
  staff                  User[]                  @relation("OwnerStaff")
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  // feature/subscriptions-resource + feature/shops-resource (พี่ปาน)
  subscription           Subscription?
  shops                  Shop[]
  // feature/staff-resource (อั้ม) — back-relation ที่ Prisma บังคับ
  shopStaffs             ShopStaff[]
  permissionsGranted     StaffPermission[]
  // feature/chatbot-resource (อั้ม) — back-relation ที่ Prisma บังคับ
  pendingStockActions    PendingStockAction[]
  chatMessages           ChatMessage[]

  @@index([email], name: "idx_user_email")
  @@index([username], name: "idx_user_username")
  @@index([lineUserId], name: "idx_user_line")
  @@index([googleId], name: "idx_user_google")
  @@index([ownerId], name: "idx_user_owner")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  usedAt    DateTime? @map("used_at") @db.Timestamptz(2)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(2)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_token_user")
  @@index([familyId], name: "idx_refresh_token_family")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(2)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_password_reset_user")
  @@map("password_reset_tokens")
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_2fa_recovery_user")
  @@map("two_factor_recovery_codes")
}

model categories {
  id           String   @id @default(uuid(7)) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  name         String   @db.VarChar(100)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[] // [เซิ่น] back-relation ที่ Prisma บังคับ — บรรทัดเดียว ไม่แตะ field อื่น

  @@unique([ownerId, name], map: "uq_category_owner_name")
  @@map("categories")
}

// =====================================================

// feature/subscriptions-resource + feature/shops-resource (พี่ปาน)
// ============================================================

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
}

model SubscriptionPlan {
  id                 String  @id @default(uuid()) @db.Uuid
  code               String  @unique @db.VarChar(50) // FREE / PLUS / PRO
  nameTh             String  @map("name_th") @db.VarChar(100)
  priceThb           Decimal @map("price_thb") @db.Decimal(12, 2)
  durationMonths     Int?    @map("duration_months") // NULL = Free Plan ไม่มีวันหมดอายุ
  includedShopQuota  Int     @default(1) @map("included_shop_quota")
  includedStaffQuota Int     @default(0) @map("included_staff_quota") // Free = 0, Plus = 6, Pro = 10
  maxActiveProducts  Int?    @map("max_active_products") // NULL = ไม่จำกัด (Paid), 100 = Free Plan
  isFree             Boolean @default(false) @map("is_free")
  isActive           Boolean @default(true) @map("is_active")

  // [อั้ม] feature-gate ตาม schema.dbml:243-245 — เดิมขาดใน schema.prisma
  // seed ต้องตั้ง true ให้ PLUS/PRO ไม่งั้น default false จะบล็อกทุกคน
  chatbotEnabled          Boolean @default(false) @map("chatbot_enabled") // Plus/Pro (SRS §71, §160)
  barcodeEnabled          Boolean @default(false) @map("barcode_enabled") // Plus/Pro (SRS §72, §167)
  aiRecommendationEnabled Boolean @default(false) @map("ai_recommendation_enabled") // Pro เท่านั้น (SRS §179, §181)

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @unique @map("user_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @map("started_at")
  expiresAt        DateTime?          @map("expires_at") // NULL สำหรับ Free Plan
  expiryNotifiedAt DateTime?          @map("expiry_notified_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([expiresAt], name: "idx_subscription_expires")
  @@map("subscriptions")
}

model Shop {
  id          String     @id @default(uuid()) @db.Uuid
  ownerId     String     @map("owner_id") @db.Uuid
  name        String     @db.VarChar(150)
  description String?
  imageUrl    String?    @map("image_url") @db.VarChar(500)
  phone       String?    @db.VarChar(20)
  address     String?
  status      ShopStatus @default(ACTIVE)
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  staff ShopStaff[] // [อั้ม] feature/staff-resource — back-relation ที่ Prisma บังคับ บรรทัดเดียว ไม่แตะ field อื่น

  // [อั้ม] feature/chatbot-resource — back-relation ที่ Prisma บังคับ
  pendingStockActions PendingStockAction[]
  chatMessages        ChatMessage[]

  @@index([ownerId, deletedAt], name: "idx_shop_owner")
  @@map("shops")
}

// =====================================================================
// feature/staff-resource (อั้ม)
// Reviewed against SRS 2026-08-20, ดู api/prisma/design/schema.dbml
// =====================================================================

/// พนักงานที่ถูกมอบหมายเข้าร้าน — เจ้าของร้านไม่มีแถวในตารางนี้ สิทธิ์เต็มมาจาก
/// shops.ownerId โดยตรง พนักงาน 1 คนมอบหมายได้หลายร้าน (หลายแถว) แต่นับเป็น
/// 1 คนใน staff quota เสมอ (SRS: "จัดสรรพนักงานจาก staff quota กลาง...ได้อย่างอิสระ")
model ShopStaff {
  id         String    @id @default(uuid(7)) @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6) // soft remove — เก็บประวัติผู้ทำรายการไว้

  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  permission StaffPermission?

  @@unique([shopId, userId], map: "uq_shop_staff")
  @@index([userId, removedAt], name: "idx_shop_staff_user")
  @@map("shop_staffs")
}

/// สิทธิ์การใช้งานของพนักงาน 1:1 กับ ShopStaff — สิทธิ์กำหนดแยกรายร้าน
/// ค่าเริ่มต้นทุกสิทธิ์ = false เสมอ (SRS: "บัญชีพนักงานที่สร้างใหม่ต้องไม่มีสิทธิ์ใดๆ")
/// ต้องเช็คคู่กับ subscription_plans ของเจ้าของร้านเสมอ 2 ชั้นก่อนอนุญาต action ใดๆ
model StaffPermission {
  id                   String   @id @default(uuid(7)) @db.Uuid
  shopStaffId          String   @unique @map("shop_staff_id") @db.Uuid
  canManageProduct     Boolean  @default(false) @map("can_manage_product")
  canAdjustStockManual Boolean  @default(false) @map("can_adjust_stock_manual")
  canUseChatbot        Boolean  @default(false) @map("can_use_chatbot")
  canScanSale          Boolean  @default(false) @map("can_scan_sale")
  canViewDashboard     Boolean  @default(false) @map("can_view_dashboard")
  canViewAiInsight     Boolean  @default(false) @map("can_view_ai_insight")
  grantedBy            String?  @map("granted_by") @db.Uuid // user id ของเจ้าของร้านที่แก้ไขล่าสุด
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  shopStaff     ShopStaff @relation(fields: [shopStaffId], references: [id], onDelete: Cascade)
  grantedByUser User?     @relation(fields: [grantedBy], references: [id], onDelete: SetNull)

  @@map("staff_permissions")
}

// ต้องเพิ่มเองใน migration ภายหลัง (Prisma schema เขียนไม่ได้โดยตรง):
// - Seed subscription_plans 3 แถวตาม SRS ฉบับล่าสุด (จำนวนร้าน/สินค้า/
//   พนักงาน เป็นจำนวนตายตัวตามแพ็กเกจ ไม่มีการซื้อสิทธิ์เพิ่มแยกต่างหาก
//   ต้องอัปเกรดแพ็กเกจเท่านั้นถึงจะได้ quota เพิ่ม):
//   - FREE: isFree=true, priceThb=0, includedShopQuota=1, includedStaffQuota=0,
//     maxActiveProducts=100, durationMonths=NULL
//   - PLUS: isFree=false, priceThb=2499, includedShopQuota=3, includedStaffQuota=6,
//     maxActiveProducts=3000, durationMonths=12
//   - PRO: isFree=false, priceThb=3499, includedShopQuota=5, includedStaffQuota=10,
//     maxActiveProducts=5000, durationMonths=12
// - Logic คำนวณ quota / read-only ดู subscription-quota.util.ts
//   (allowed = includedShopQuota ตรงๆ ตามแพ็กเกจ, used = COUNT(shops
//   WHERE ownerId = userId AND deletedAt IS NULL), สร้างร้านได้เมื่อ
//   status = ACTIVE AND used < allowed)
// =====================================================================
// [เซิ่น] feature/products-resource + feature/shop-products-resource
// =====================================================================

/// Product Catalog กลาง ระดับเจ้าของร้าน (owner) — ใช้ร่วมกันได้ทุกร้าน
/// SRS: สินค้าเดียวกันใช้หลายร้าน นับ product quota เพียง 1 รายการ
model Product {
  id         String    @id @default(uuid(7)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  categoryId String?   @map("category_id") @db.Uuid
  name       String    @db.VarChar(200)
  barcode    String?   @db.VarChar(50)
  unit       String    @db.VarChar(20)
  imageUrl   String?   @map("image_url") @db.VarChar(500)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category     categories?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shopProducts ShopProduct[]

  @@index([ownerId, deletedAt], name: "idx_product_owner_deleted")
  @@index([ownerId, name], name: "idx_product_owner_name")
  @@index([categoryId], name: "idx_product_category")
  @@map("products")
}

enum ShopProductStatus {
  ACTIVE
  INACTIVE

  @@map("shop_product_status")
}

/// สินค้าที่แต่ละร้านเลือกมาขาย — ราคาขาย/ต้นทุน/สต็อก แยกตามร้าน
/// SRS: "ข้อมูลระดับร้านต้องประกอบด้วยราคาขาย ต้นทุน จำนวน stock low-stock threshold และสถานะ"
model ShopProduct {
  id                String            @id @default(uuid(7)) @db.Uuid
  shopId            String            @map("shop_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  sellPrice         Decimal           @map("sell_price") @db.Decimal(12, 2)
  costPrice         Decimal           @map("cost_price") @db.Decimal(12, 2)
  stockQty          Int               @default(0) @map("stock_qty")
  lowStockThreshold Int               @default(0) @map("low_stock_threshold")
  status            ShopProductStatus @default(ACTIVE)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // TODO(shops): เพิ่ม relation ไป model Shop เมื่อ feature/shops-resource เข้า dev
  //   shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId], map: "uq_shop_product")
  @@index([shopId, status], name: "idx_shop_product_shop_status")
  @@index([productId], name: "idx_shop_product_product")
  @@map("shop_products")
}

// =====================================================================
// [อั้ม] feature/chatbot-resource
// ตรงตาม prisma/design/schema.dbml:551-598 (review กับ SRS แล้ว 2026-08-20)
// =====================================================================

enum ChatChannel {
  WEB
  LINE

  @@map("chat_channel")
}

enum ChatRole {
  USER
  ASSISTANT

  @@map("chat_role")
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  FAILED

  @@map("pending_action_status")
}

/// คำสั่งปรับสต็อกจากแชทที่ตีความแล้วแต่ยังรอผู้ใช้ยืนยัน
/// ต้อง persist ลง DB ไม่ใช่เก็บใน memory เพราะการยืนยันอาจมาคนละ request
/// คนละ process (เช่น LINE webhook อีก 5 นาทีถัดมา) — SRS §162-165
model PendingStockAction {
  id          String              @id @default(uuid(7)) @db.Uuid
  shopId      String              @map("shop_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  channel     ChatChannel
  rawText     String              @map("raw_text")
  parsedItems Json                @map("parsed_items")
  status      PendingActionStatus @default(PENDING)
  errorReason String?             @map("error_reason")
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(6)
  confirmedAt DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  chatMessages ChatMessage[]

  @@index([shopId, status], name: "idx_pending_shop_status")
  @@index([userId, status], name: "idx_pending_user_status")
  @@index([expiresAt], name: "idx_pending_expires")
  @@map("pending_stock_actions")
}

/// ประวัติแชทของผู้ใช้ต่อร้าน ทั้งฝั่งเว็บและ LINE
model ChatMessage {
  id              String      @id @default(uuid(7)) @db.Uuid
  shopId          String      @map("shop_id") @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  channel         ChatChannel
  role            ChatRole
  content         String
  pendingActionId String?     @map("pending_action_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  pendingAction PendingStockAction? @relation(fields: [pendingActionId], references: [id], onDelete: SetNull)

  @@index([shopId, userId, createdAt], name: "idx_chat_scope_date")
  @@map("chat_messages")
}
